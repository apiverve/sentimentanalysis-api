        "social media sentiment analysis api",
        "text analysis api"
    ],
    "homepage": "https://apiverve.com/marketplace/sentimentanalysis?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
